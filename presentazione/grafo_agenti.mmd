---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	accoglienza(accoglienza)
	guida_alla_foto(guida_alla_foto)
	analisi(analisi)
	instradamento(instradamento)
	followup(followup)
	__end__([<p>__end__</p>]):::last
	__start__ --> accoglienza;
	accoglienza -.-> __end__;
	accoglienza -.-> guida_alla_foto;
	analisi -.-> __end__;
	analisi -.-> instradamento;
	guida_alla_foto -.-> analisi;
	instradamento -.-> __end__;
	instradamento -.-> followup;
	followup --> __end__;
	guida_alla_foto -.-> guida_alla_foto;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
