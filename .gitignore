# Chiave API e segreti: non deve MAI finire su GitHub
.env

# Ambiente virtuale Python: si ricrea in locale, non va versionato
.venv/

# File compilati/cache generati automaticamente da Python
__pycache__/
*.pyc

# Database SQLite: viene rigenerato dai dati demo, non va versionato
*.db
*.sqlite
*.sqlite3

# File collaterali della modalità WAL di SQLite (usata anche dallo stato
# salvato del grafo, data/stato_grafo.db): non finiscono in ".db", *.db sopra
# non li copre.
*.db-wal
*.db-shm

# Immagini caricate dagli utenti durante l'uso dell'app
data/uploads/

# Secrets usati solo in fase di pubblicazione su Streamlit Community Cloud
.streamlit/secrets.toml

# Impostazioni locali di Claude Code (l'assistente usato per sviluppare il progetto):
# non è codice del progetto, è specifico di questo computer.
.claude/
